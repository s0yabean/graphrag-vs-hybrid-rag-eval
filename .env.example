# Copy to .env and fill in. Nothing here is a real value.

# The Obsidian vault to index. Relative paths resolve from the repo root.
VAULT_PATH=sample_vault
# Whose notes these are: "I" and "me" in the notes are resolved to this person.
AUTHOR_NAME=Ruth Calloway

# Neo4j (docker compose up -d starts one with this password)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Host ports for docker-compose.yml; change both ports here and in NEO4J_URI if 7474/7687 are taken.
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# Embeddings.
#   ollama:    bge-m3 through Ollama (`ollama pull bge-m3`; 1.2 GB, 1,024 dims, multilingual). Used for the published results.
#   fastembed: BAAI/bge-small-en-v1.5 on CPU (about 70 MB, 384 dims, English). Quickstart default.
EMBED_BACKEND=fastembed
# EMBED_MODEL=
# EMBED_DIMS=
# OLLAMA_URL=http://localhost:11434
# EMBED_MODEL_PATH=   (fastembed only: a folder holding a pre-downloaded model, for offline use)

# Entities mentioned in more chunks than this become hubs that traversal never passes through.
# The published 31,047-chunk graph used 300; 15 suits the 50-note sample vault.
HUB_MENTIONS=15

# Optional: only extract_entities.py uses it.
ANTHROPIC_API_KEY=
# EXTRACT_MODEL=claude-haiku-5-5
